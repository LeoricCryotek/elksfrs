<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="qbo_connection_company" model="ir.rule">
        <field name="name">QBO connections by company</field><field name="model_id" ref="model_elks_qbo_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="qbo_account_company" model="ir.rule">
        <field name="name">QBO account mappings by company</field><field name="model_id" ref="model_elks_qbo_account_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="qbo_vendor_company" model="ir.rule">
        <field name="name">QBO vendor mappings by company</field><field name="model_id" ref="model_elks_qbo_vendor_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="qbo_expense_company" model="ir.rule">
        <field name="name">QBO expenses by company</field><field name="model_id" ref="model_elks_qbo_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
