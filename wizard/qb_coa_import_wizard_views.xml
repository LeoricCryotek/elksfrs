<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qb_coa_import_wizard_form" model="ir.ui.view">
        <field name="name">qb.coa.import.wizard.form</field>
        <field name="model">qb.coa.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Chart of Accounts from QuickBooks">
                <sheet>
                    <div class="oe_title">
                        <h1>Import Chart of Accounts</h1>
                        <div class="text-muted">
                            Import your lodge's Chart of Accounts from a
                            QuickBooks CSV export. Existing accounts are
                            updated; new accounts are created. Nothing is
                            deleted.
                        </div>
                    </div>

                    <group invisible="state != 'draft'">
                        <group string="File">
                            <field name="csv_file" filename="filename"
                                   widget="binary"/>
                            <field name="filename" invisible="1"/>
                            <field name="encoding"/>
                        </group>
                        <group string="Options">
                            <field name="update_existing_names"/>
                            <field name="infer_missing_departments"/>
                        </group>
                    </group>

                    <group invisible="state == 'draft'"
                           string="Results">
                        <group>
                            <field name="stats_created" readonly="1"/>
                            <field name="stats_updated" readonly="1"/>
                        </group>
                        <group>
                            <field name="stats_skipped" readonly="1"/>
                            <field name="stats_errors" readonly="1"/>
                        </group>
                    </group>

                    <field name="report_html" invisible="state == 'draft'"
                           readonly="1" nolabel="1"/>

                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_preview" type="object"
                            string="Preview"
                            class="btn-secondary"
                            invisible="state != 'draft'"
                            help="Parse the CSV and show what would happen without writing to the database."/>
                    <button name="action_apply" type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qb_coa_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Chart of Accounts (QuickBooks CSV)</field>
        <field name="res_model">qb.coa.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
